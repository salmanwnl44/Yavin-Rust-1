# Every text file is checked out with LF, on every platform. Prettier requires LF, and the
# Windows CI runner's default (core.autocrlf=true) otherwise checks out CRLF, failing
# `format:check` on every file. The repository already stores LF throughout.
* text=auto eol=lf

# Extension packages (IDE-09) are byte-exact: their SHA-256 is in the registry index.
*.yvx binary
